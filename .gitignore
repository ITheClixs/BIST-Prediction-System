# Python
__pycache__/
*.py[cod]
*.egg-info/
dist/
build/
.venv/
*.so

# Rust
target/

# Tooling caches
.mypy_cache/
.ruff_cache/
.pytest_cache/
.coverage
htmlcov/

# Local data and local run output. The accepted benchmark bundle under runs/ is
# committed deliberately, with `git add -f`, because the published results are
# read back out of it.
data/
*.db
runs/
prediction_tracking/

# Editors and OS
.idea/
.vscode/
*.swp
.DS_Store

# Local configuration; config.example.toml is the committed template.
config.toml

# The arXiv package is assembled from committed sources by tools/build_arxiv.py.
# Committing the staging tree or the tarball would store the same bytes twice
# and let the two drift.
paper/arxiv/
paper/arxiv-submission.tar.gz

# Intermediates left by the typesetter.
paper/main.aux
paper/main.bbl
paper/main.blg
paper/main.log
paper/main.out
paper/main.xdv
